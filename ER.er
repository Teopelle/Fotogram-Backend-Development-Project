{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":66,"erCode":"/* Entities */\nentity UTENTE {\n    username (id),\n    mail (id),\n    passw (id),\n    immagine (optional),\n    eBannato\n}\nentity POST {\n    numLike,\n    id (id),\n    eFlaggato {\n        numFlag\n    },\n    tipo,\n    username,\n    data\n}\nentity MODERATORE {\n    dataNomina\n}\nentity AMMINISTRATORE\nentity IMMAGINE {\n    imageUrl\n}\nentity TESTO {\n    textContent\n}\nentity SESSIONE {\n    idSessione (id)\n}\n\n/* Relationships */\nrelationship CREA (\n    UTENTE: zero..many,\n    POST: one..many\n)\nrelationship LOGIN (\n    UTENTE: zero..one,\n    SESSIONE: one..one\n) {\n    dataLogin\n}\nrelationship MODERA (\n    MODERATORE: zero..many,\n    POST: zero..many,\n    AMMINISTRATORE: zero..many\n) {\n    dataModerazione\n}\nrelationship SEGUE (\n    UTENTE \"seguitore\": zero..many,\n    UTENTE \"seguito\": zero..many\n) {\n    dataFollow\n}\nrelationship LIKE (\n    UTENTE: zero..many,\n    POST: zero..many\n) {\n    dataLike\n}\nrelationship FLAG (\n    UTENTE: zero..many,\n    POST: zero..many\n) {\n    dataFlag\n}\n\n/* Generalizations */\nMODERATORE <= {\n    UTENTE\n} (partial, exclusive)\nAMMINISTRATORE <= {\n    UTENTE\n} (partial, exclusive)\nIMMAGINE <= {\n    POST\n} (total, exclusive)\nTESTO <= {\n    POST\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-602,"_y":-395,"_mag":false},{"__type":"Entity","_id":2,"_name":"POST","_x":252,"_y":-388,"_mag":false},{"__type":"Entity","_id":3,"_name":"MODERATORE","_x":-742,"_y":-70,"_mag":false},{"__type":"Entity","_id":4,"_name":"AMMINISTRATORE","_x":-468,"_y":-69,"_mag":false},{"__type":"Generalization","_id":5,"_type":"p_e","_entityId":3},{"__type":"GeneralizationChild","_id":6,"_entityId":1,"_generalizationId":5},{"__type":"Generalization","_i