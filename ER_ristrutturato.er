{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":97,"erCode":"/* Entities */\nentity UTENTE {\n    username (id),\n    mail (id),\n    passw (id),\n    immagine (optional),\n    eBannato,\n    numFollow,\n    numFollowers,\n    postModerati,\n    dataNomina (optional),\n    eModeratore,\n    eAmministratore\n}\nentity POST {\n    numLike,\n    id (id),\n    eModerato,\n    username,\n    data,\n    numFlag,\n    eTesto,\n    eImmagine,\n    imageUrl,\n    textContent\n}\nentity SESSIONE {\n    idSessione (id)\n}\n\n/* Relationships */\nrelationship CREA (\n    UTENTE: zero..many,\n    POST: one..many\n)\nrelationship LOGIN (\n    UTENTE: zero..one,\n    SESSIONE: one..one\n) {\n    dataLogin\n}\nrelationship MODERA (\n    POST: zero..many,\n    UTENTE: zero..many\n) {\n    dataModerazione\n}\nrelationship SEGUE (\n    UTENTE \"seguitore\": zero..many,\n    UTENTE \"seguito\": zero..many\n) {\n    dataFollow\n}\nrelationship LIKE (\n    UTENTE: zero..many,\n    POST: zero..many\n) {\n    dataLike\n}\nrelationship FLAG (\n    UTENTE: zero..many,\n    POST: zero..many\n) {\n    dataFlag\n}","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-602,"_y":-395,"_mag":false},{"__type":"Entity","_id":2,"_name":"POST","_x":335,"_y":-319,"_mag":false},{"__type":"Attribute","_id":16,"_name":"username","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":35,"_y":-141},{"__type":"Attribute","_id":18,"_name":"mail","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-43,"_y":-125},{"__type":"Attribute","_id":20,"_name":"passw","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":111,"_y":-119},{"__type":"Attribute","_id":25,"_name":"numLike","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parent